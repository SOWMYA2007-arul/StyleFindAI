# ============================================================
# StyleFind AI - environment configuration
# Copy this file to ".env" (same folder) and edit the values.
#   PowerShell:  Copy-Item .env.example .env
# Never commit the real .env file.
# ============================================================

# ---------- PostgreSQL + pgvector ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stylefind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# ---------- Python AI service (FastAPI) ----------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
# Which encoder answers search requests. Options:
#   fashion-clip   (primary, patrickjohncyh/fashion-clip, 512-d)
#   openclip-b32   (baseline, OpenCLIP ViT-B/32 laion2b, 512-d)
#   dinov2-b14     (experimental, facebook/dinov2-base, 768-d)
#   cv-baseline    (classical OpenCV colour/texture/shape features, no download, for testing)
AI_PRIMARY_MODEL=fashion-clip
# Where Hugging Face caches downloaded weights (keeps them out of git)
HF_HOME=./.model-cache
# cpu (laptop default) or cuda (Colab / NVIDIA GPU)
AI_DEVICE=cpu
AI_BATCH_SIZE=16
# How many encoders may stay in RAM at once (1 is safest on 16 GB)
AI_MAX_LOADED_MODELS=1
# Hybrid ranking weights (normalised automatically)
RANK_W_VISUAL=0.65
RANK_W_COLOUR=0.15
RANK_W_PATTERN=0.10
RANK_W_ATTRIBUTE=0.10
# Candidates pulled from pgvector before re-ranking. Measure before changing:
#   python scripts/evaluate.py --models fashion-clip --candidates 50 100 200
SEARCH_CANDIDATES=50
# hnsw.ef_search: 0 = automatic (max(100, 2 x candidates)); see docs/INDEX_BENCHMARK.md
HNSW_EF_SEARCH=0
# pgvector >= 0.8: keep scanning the HNSW graph until enough rows pass filters
HNSW_ITERATIVE_SCAN=true
# If a filtered search still returns too few rows, compare all matching products exactly
FILTERED_EXACT_FALLBACK=true
# Query multi-crop: off | max_score | mean_embedding (evaluate first: scripts/evaluate.py --multicrop max_score)
SEARCH_MULTICROP=off
# Pin Hugging Face model revisions (commit hash). Leave EMPTY to keep your existing embeddings valid;
# setting a revision creates a new model_version that needs: generate_embeddings.py --model fashion-clip
FASHION_CLIP_REVISION=
DINOV2_REVISION=
# Garment isolation used when a search asks for crop=true ("Focus on the garment"). Details: docs/SEGMENTATION.md
#   auto (default)  = segmentation pipeline using the optional models enabled below (none = no download)
#   foreground      = pipeline with weight-free methods only (the v2 setting; still works)
#   yolo            = pipeline + YOLO garment detector (needs CLOTHING weights in YOLO_WEIGHTS)
#   off             = always the full image
GARMENT_ISOLATION=auto
ISOLATION_PADDING=0.06
# crop scope when no target garment is given: all_garments | main_garment
ISOLATION_DEFAULT=all_garments
# auto | light (never load a model) | off
SEGMENTATION_STRATEGY=auto
MIN_SEGMENTATION_CONFIDENCE=0.4
SEGMENTATION_TIMEOUT_S=20
BOUNDARY_REFINEMENT=guided
SEGMENTATION_CACHE_SIZE=64
EMBEDDING_CACHE_SIZE=256
# --- optional models (all off by default; see docs/SEGMENTATION.md section 3) ---
# Garment detector: needs clothing-trained YOLO weights. Standard COCO weights (yolo11n.pt) have NO garment classes.
GARMENT_DETECTOR=none
YOLO_WEIGHTS=yolo11n.pt
DETECTION_MIN_CONFIDENCE=0.35
DETECTION_MIN_BOX_AREA=0.02
DETECTION_MAX_INSTANCES=10
# Person masks from COCO YOLO-seg (recommended for photos of people; Ultralytics = AGPL-3.0)
PERSON_SEGMENTER=none
PERSON_YOLO_WEIGHTS=../.model-cache/yolo/yolo11n-seg.pt
# Human parsing (face/hair/skin/upper/pants/skirt/dress...). Downloads ~110 MB on first use.
HUMAN_PARSER=none
HUMAN_PARSER_MODEL=mattmdjaga/segformer_b2_clothes
HUMAN_PARSER_SIZE=512
# SAM 2 boundary refinement of the chosen garment (GPU recommended)
ENABLE_SAM2=false
SAM2_CHECKPOINT=
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
# Pose (only used on photos of people)
POSE_ESTIMATOR=none
POSE_MODEL_PATH=
# legacy switch from v1/v2 (true = same as GARMENT_ISOLATION=yolo)
ENABLE_GARMENT_DETECTION=false
ENABLE_VLM_ATTRIBUTES=false
VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# Shared secret so only the Node backend can call admin-only AI endpoints
AI_INTERNAL_TOKEN=change_me_internal_token

# ---------- Node.js backend (Express) ----------
BACKEND_PORT=4000
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=60000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Admin session cookie: Secure flag is automatic when NODE_ENV=production; force it behind HTTPS with:
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8
# Save anonymous search history (no images, no personal data). true/false
STORE_SEARCH_HISTORY=true

# ---------- Paths (relative to the project root) ----------
PRODUCTS_DIR=dataset/products
UPLOADS_DIR=dataset/uploads
